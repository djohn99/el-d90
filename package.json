{
  "name": "el-d90",
  "productName": "el-d90",
  "version": "0.5.1",
  "description": "Your local Kubernetes workspace",
  "author": "David John",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.cjs",
    "package": "electron-packager . el-d90 --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=local.davidjohn.el-d90 --app-category-type=public.app-category.developer-tools --ignore=^/research --ignore=^/test --ignore=^/dist --ignore=^/scripts --icon=assets/el-d90.icns --asar.unpackDir=assets --app-copyright='Copyright \u00a9 2026 David John' --ignore=^/[.]github",
    "build:native": "clang -arch arm64 -mmacosx-version-min=13.0 -O2 -Wall -Wextra src/pty.c -o assets/el-d90-pty",
    "postinstall": "node node_modules/electron/install.js",
    "prestart": "npm run build:native",
    "predemo": "npm run build:native",
    "prepackage": "npm run build:native",
    "test:desktop": "node test/desktop-smoke.cjs",
    "pretest": "npm run build:native",
    "test:workspaces": "node test/workspaces-smoke.cjs",
    "test:helm-history": "node test/helm-history-smoke.cjs",
    "test:desktop-all": "npm run test:desktop && npm run test:workspaces && npm run test:helm-history && npm run test:node-access && npm run test:events && npm run test:scaling && npm run test:sessions",
    "test:node-access": "node test/node-access-smoke.cjs",
    "test:events": "node test/events-smoke.cjs",
    "test:scaling": "node test/scaling-smoke.cjs",
    "test:all": "npm test && npm run test:desktop-all",
    "test:sessions": "node test/sessions-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0",
    "playwright": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djohn99/el-d90.git"
  },
  "homepage": "https://github.com/djohn99/el-d90#readme",
  "bugs": {
    "url": "https://github.com/djohn99/el-d90/issues"
  }
}
